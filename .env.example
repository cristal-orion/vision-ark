# ── form-relay ────────────────────────────────────────────────────────────
# L'invio del modulo passa dal relay condiviso sulla VPS. Qui non c'è nessuna
# chiave segreta: solo l'indirizzo dell'endpoint e l'id di questo sito.
# La chiave del provider di posta sta sul server, non nel browser.

PUBLIC_FORM_RELAY_URL=https://moduli.twobee.it
PUBLIC_FORM_RELAY_SITE=vision-ark
