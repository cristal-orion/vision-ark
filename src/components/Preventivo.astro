---
/**
 * Il configuratore di preventivo. Gli step arrivano da src/data/preventivo.ts:
 * aggiungere una domanda là dentro basta, qui non si tocca niente.
 *
 * Progressive enhancement: senza JS tutti gli step restano visibili e il
 * <noscript> offre i contatti diretti. Con JS il form diventa a passi.
 */
import { Image } from "astro:assets";
import colazioni from "../assets/img/05-sala-colazioni.png";
import { steps } from "../data/preventivo";

const total = String(steps.length).padStart(2, "0");
---

<section class="preventivo section" id="preventivo">
  <div class="shell">
    <div class="head">
      <h2 class="head__title">Richiedi il tuo preventivo</h2>
      <p class="head__note">
        Tre domande per inquadrare il lavoro, poi i tuoi contatti. Ti
        rispondiamo con le domande tecniche che servono a fare un numero
        serio &mdash; non con un listino a caso.
      </p>
    </div>

    <div class="preventivo__split">
      <div class="preventivo__form-col">
        <form class="quote" id="quote" novalidate data-total={steps.length}>
          <!-- Avanzamento -->
          <div class="quote__progress">
            <p class="quote__counter" aria-hidden="true">
              <span data-quote-current>01</span><span class="quote__slash">/</span
              ><span>{total}</span>
            </p>
            <ol class="quote__ticks">
              {
                steps.map((step, i) => (
                  <li class="tick" data-quote-tick={i} aria-current={i === 0 ? "step" : undefined}>
                    <span class="tick__bar" />
                    <span class="tick__label">{step.tag}</span>
                  </li>
                ))
              }
            </ol>
          </div>

          <p class="quote__live visually-hidden" role="status" aria-live="polite" data-quote-live></p>

          <!-- Step -->
          {
            steps.map((step, i) => (
              <section
                class="step"
                data-quote-step={i}
                aria-label={`Passo ${i + 1} di ${steps.length}: ${step.tag}`}
              >
                <h3 class="step__question">{step.question}</h3>
                {step.note && <p class="step__note">{step.note}</p>}

                <div class="step__fields">
                  {step.fields.map((field) =>
                    field.kind === "choice" ? (
                      <fieldset class="choice" data-field={field.name} data-required={field.required}>
                        <legend class="visually-hidden">{field.label}</legend>
                        <div class="choice__grid">
                          {field.options.map((option) => (
                            <label class="card">
                              <input
                                class="visually-hidden card__input"
                                type={field.multiple ? "checkbox" : "radio"}
                                name={field.name}
                                value={option.value}
                              />
                              <span class="card__title">{option.label}</span>
                              {option.note && <span class="card__note">{option.note}</span>}
                              <span class="card__tick" aria-hidden="true">
                                &#10003;
                              </span>
                            </label>
                          ))}
                        </div>
                        <p class="error" data-error-for={field.name} role="alert"></p>
                      </fieldset>
                    ) : field.kind === "consent" ? (
                      <div class="consent" data-field={field.name} data-required={field.required}>
                        <label class="consent__row">
                          <input
                            class="consent__box"
                            type="checkbox"
                            name={field.name}
                            required={field.required}
                          />
                          <span class="consent__text">{field.label}</span>
                        </label>
                        <p class="error" data-error-for={field.name} role="alert"></p>
                      </div>
                    ) : field.kind === "textarea" ? (
                      <div class="field field--wide" data-field={field.name} data-required={field.required}>
                        <label class="field__label" for={`f-${field.name}`}>
                          {field.label}
                          {!field.required && <span class="field__opt"> — facoltativo</span>}
                        </label>
                        <textarea
                          class="field__control"
                          id={`f-${field.name}`}
                          name={field.name}
                          rows={field.rows ?? 4}
                          placeholder={field.placeholder}
                        />
                        <p class="error" data-error-for={field.name} role="alert"></p>
                      </div>
                    ) : (
                      <div
                        class="field"
                        class:list={[{ "field--wide": field.span === 2 }]}
                        data-field={field.name}
                        data-required={field.required}
                      >
                        <label class="field__label" for={`f-${field.name}`}>
                          {field.label}
                        </label>
                        <input
                          class="field__control"
                          id={`f-${field.name}`}
                          type={field.kind}
                          name={field.name}
                          placeholder={field.placeholder}
                          autocomplete={field.autocomplete}
                          required={field.required}
                        />
                        <p class="error" data-error-for={field.name} role="alert"></p>
                      </div>
                    ),
                  )}
                </div>
              </section>
            ))
          }

          <!-- Comandi -->
          <div class="quote__actions">
            <button class="btn btn--ghost" type="button" data-quote-prev hidden>
              <span aria-hidden="true">&larr;</span>
              Indietro
            </button>

            <button class="btn" type="button" data-quote-next>
              Avanti
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </button>

            <button class="btn btn--accent" type="submit" data-quote-submit hidden>
              <span data-quote-submit-label>Invia la richiesta</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>

          <p class="quote__fail" role="alert" data-quote-fail hidden></p>
        </form>

        <!-- Stato di successo: sostituisce il form -->
        <div class="done" data-quote-done hidden>
          <p class="done__mark" aria-hidden="true">&#10003;</p>
          <h3 class="done__title">Richiesta inviata</h3>
          <p class="done__note">
            Grazie. Abbiamo la tua richiesta e ti ricontattiamo entro due
            giorni lavorativi. Se nel frattempo hai planimetrie o foto dello
            stato attuale, tienile a portata di mano: accorciano di molto il
            primo giro di domande.
          </p>
        </div>

        <noscript>
          <p class="quote__noscript">
            Il modulo a passi ha bisogno di JavaScript. Scrivici direttamente a
            <a class="quote__mail" href="mailto:info@visionark.it">info@visionark.it</a>
            indicando se si tratta di una casa o di un&rsquo;attivit&agrave;, quali
            ambienti e dove si trova l&rsquo;immobile.
          </p>
        </noscript>
      </div>

      <aside class="preventivo__aside">
        <figure class="figure preventivo__figure">
          <Image
            src={colazioni}
            alt="Sala colazioni: tavoli tondi in marmo, sedute chiare, lampade a sospensione in vetro e ottone, vetrata sul verde."
            widths={[480, 760, 1100]}
            sizes="(width < 60rem) 100vw, 34vw"
            loading="lazy"
          />
          <figcaption class="figure__caption">Sala colazioni</figcaption>
        </figure>

        <ul class="reassure">
          <li class="reassure__item">Rispondiamo entro 2 giorni lavorativi.</li>
          <li class="reassure__item">Il sopralluogo serve prima del numero, non dopo.</li>
          <li class="reassure__item">I tuoi dati restano nostri: nessuna lista, nessun giro.</li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<script>
  import "../scripts/preventivo";
</script>

<style>
  .preventivo__split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(var(--space-xl), 5vw, var(--space-3xl));
    align-items: start;
  }

  /* ─── Avanzamento ───────────────────────────────────────────────────── */

  .quote__progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    padding-block-end: var(--space-md);
    border-block-end: var(--rule-slab) solid var(--color-ink);
  }

  .quote__counter {
    font-family: var(--font-outlier);
    font-size: var(--text-md);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .quote__slash {
    margin-inline: 0.15em;
    /* muted e non neutral: qui è testo piccolo, serve 4.5:1 */
    color: var(--color-muted);
  }

  .quote__ticks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-inline-start: auto;
  }

  .tick {
    display: grid;
    gap: var(--space-2xs);
    min-width: 6.5rem;
  }

  .tick__bar {
    display: block;
    height: var(--rule-slab);
    background: var(--color-rule);
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .tick__label {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--dur-short) var(--ease-out);
  }

  .tick[data-done] .tick__bar {
    background: var(--color-ink);
  }

  .tick[aria-current="step"] .tick__bar {
    background: var(--color-accent);
  }

  .tick[aria-current="step"] .tick__label {
    color: var(--color-ink);
  }

  /* ─── Step ──────────────────────────────────────────────────────────── */

  .step {
    padding-block-start: clamp(var(--space-lg), 3vw, var(--space-xl));
  }

  /* step-swap: il solo movimento del form, un dissolvenza in salita */
  .step[data-quote-active] {
    animation: step-swap var(--dur-short) var(--ease-out) both;
  }

  @keyframes step-swap {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step[data-quote-active] {
      animation: step-swap-reduced 150ms linear both;
    }

    @keyframes step-swap-reduced {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  .step__question {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(var(--text-xl), 3.2vw + 0.4rem, var(--text-3xl));
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    overflow-wrap: anywhere;
    min-width: 0;
    max-width: 22ch;
  }

  .step__note {
    margin-block-start: var(--space-sm);
    max-width: 52ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .step__fields {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
  }

  /* ─── Card selezionabili ────────────────────────────────────────────── */

  .choice {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .choice__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-md);
  }

  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    min-height: 44px;
    padding: clamp(var(--space-md), 2vw, var(--space-lg));
    padding-inline-end: calc(var(--space-xl) + var(--space-xs));
    background: var(--color-paper);
    border: var(--rule-slab) solid var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .card:hover,
  .card.is-hover {
    border-color: var(--color-accent);
  }

  .card:active,
  .card.is-active {
    transform: translateY(1px);
  }

  /* il focus vive sulla card, non sull'input nascosto */
  .card:has(.card__input:focus-visible) {
    outline: var(--rule-slab) solid var(--color-focus);
    outline-offset: 2px;
  }

  .card:has(.card__input:checked),
  .card.is-checked {
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-color: var(--color-ink);
  }

  .card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-md);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .card__note {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-muted);
  }

  .card:has(.card__input:checked) .card__note,
  .card.is-checked .card__note {
    color: var(--color-on-ink-2);
  }

  .card__tick {
    position: absolute;
    inset-block-start: clamp(var(--space-md), 2vw, var(--space-lg));
    inset-inline-end: clamp(var(--space-md), 2vw, var(--space-lg));
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease-out);
  }

  .card:has(.card__input:checked) .card__tick,
  .card.is-checked .card__tick {
    opacity: 1;
  }

  .choice[data-invalid] .card {
    border-color: var(--color-danger);
  }

  /* ─── Campi di testo ────────────────────────────────────────────────── */

  .step__fields:has(.field) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .field {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .field--wide,
  .consent,
  .step__fields > .choice {
    grid-column: 1 / -1;
  }

  .field__label {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .field__opt {
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .field__control {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border: var(--rule-slab) solid var(--color-ink);
    font-size: var(--text-base);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out);
  }

  .field__control::placeholder {
    color: var(--color-muted);
  }

  .field__control:hover,
  .field__control.is-hover {
    background: var(--color-paper);
  }

  .field__control:focus {
    background: var(--color-paper);
    outline: none;
  }

  .field__control:focus-visible {
    outline: var(--rule-slab) solid var(--color-focus);
    outline-offset: 2px;
  }

  textarea.field__control {
    min-height: 0;
    resize: vertical;
    line-height: 1.5;
  }

  .field[data-invalid] .field__control {
    background: var(--color-danger-soft);
    border-color: var(--color-danger);
  }

  .field__control[disabled],
  .field__control.is-disabled {
    background: var(--color-paper-3);
    border-color: var(--color-rule);
    color: var(--color-muted);
    cursor: not-allowed;
  }

  /* ─── Consenso ──────────────────────────────────────────────────────── */

  .consent__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    padding-block-start: var(--space-xs);
    cursor: pointer;
  }

  .consent__box {
    appearance: none;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: 0;
    background: var(--color-paper-2);
    border: var(--rule-slab) solid var(--color-ink);
    display: grid;
    place-content: center;
    cursor: pointer;
    transition: background-color var(--dur-micro) var(--ease-out);
  }

  .consent__box::after {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background: var(--color-accent);
    transform: scale(0);
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .consent__box:checked::after {
    transform: scale(1);
  }

  .consent__box:hover {
    background: var(--color-paper);
  }

  .consent__text {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .consent[data-invalid] .consent__box {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }

  /* ─── Errori ────────────────────────────────────────────────────────── */

  .error {
    /* Lo spazio è riservato anche quando il messaggio è vuoto: se comparisse
       dal nulla spingerebbe giù il resto del form a ogni validazione. */
    min-height: 1lh;
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-danger);
  }

  /* ─── Comandi ───────────────────────────────────────────────────────── */

  .quote__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .quote__actions [data-quote-next],
  .quote__actions [data-quote-submit] {
    margin-inline-start: auto;
  }

  .quote__fail {
    margin-block-start: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-danger-soft);
    border-inline-start: var(--rule-heavy) solid var(--color-danger);
    font-size: var(--text-sm);
    color: var(--color-danger);
  }

  .quote__noscript {
    margin-block-start: var(--space-lg);
    padding: var(--space-md);
    border: var(--rule-slab) solid var(--color-ink);
    font-size: var(--text-sm);
  }

  .quote__mail {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* ─── Successo ──────────────────────────────────────────────────────── */

  .done {
    display: grid;
    gap: var(--space-md);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    border: var(--rule-slab) solid var(--color-ink);
    background: var(--color-paper-2);
  }

  .done__mark {
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-accent-text);
  }

  .done__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .done__note {
    max-width: 52ch;
    color: var(--color-ink-2);
  }

  /* ─── Colonna laterale ──────────────────────────────────────────────── */

  .preventivo__aside {
    display: grid;
    gap: var(--space-lg);
    position: sticky;
    inset-block-start: 7rem;
  }

  .preventivo__figure {
    aspect-ratio: 4 / 5;
    border: var(--rule-slab) solid var(--color-ink);
  }

  .reassure {
    display: grid;
  }

  .reassure__item {
    padding-block: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .reassure__item:last-child {
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  /* ─── Adattamenti ───────────────────────────────────────────────────── */

  @media (width < 60rem) {
    .preventivo__split {
      grid-template-columns: minmax(0, 1fr);
    }

    .preventivo__aside {
      position: static;
      order: -1;
    }

    .preventivo__figure {
      aspect-ratio: 16 / 10;
    }
  }

  @media (width < 40rem) {
    .step__fields:has(.field) {
      grid-template-columns: minmax(0, 1fr);
    }

    .quote__ticks {
      display: none;
    }

    .quote__actions .btn {
      flex: 1 1 100%;
      margin-inline-start: 0;
    }
  }
</style>
