---
/**
 * H2 · Split diptych — knobs: ratio=7/5 · lato destro=fotografia ·
 * divisore=regola verticale da 3px. Il render sfonda fino al bordo destro
 * del viewport: è l'unico elemento che rompe la griglia in tutta la pagina.
 */
import { Image } from "astro:assets";
import lounge from "../assets/img/04-lounge.png";
---

<section class="hero" id="top">
  <div class="hero__text">
    <p class="label reveal" style="--i: 0">Progettazione &middot; Edilizia &middot; Interior design</p>

    <h1 class="display hero__display reveal" style="--i: 1">
      <span class="hero__line">Dalla progettazione</span>
      <span class="hero__line"><span class="slab">alla realizzazione</span></span>
    </h1>

    <p class="lede hero__lede reveal" style="--i: 2">
      Un&rsquo;impresa edile con uno studio di progettazione dentro. Ristrutturiamo
      case e attivit&agrave; chiavi in mano: un solo interlocutore dal rilievo
      alla consegna.
    </p>

    <div class="hero__actions reveal" style="--i: 3">
      <a class="btn" href="/#preventivo">
        Richiedi il preventivo
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn btn--ghost" href="/#metodo">Come lavoriamo</a>
    </div>
  </div>

  <figure class="figure hero__figure">
    <Image
      src={lounge}
      alt="Lounge di una struttura ricettiva: boiserie grafite, divano curvo in velluto ocra, applique in ottone."
      widths={[560, 900, 1400]}
      sizes="(width < 60rem) 100vw, 42vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    /* minmax(0, …) e non 1fr secco: le tracce con immagini non devono
       poter crescere oltre la colonna (gate 61) */
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    border-block-end: var(--rule-slab) solid var(--color-ink);
  }

  .hero__text {
    display: grid;
    align-content: center;
    gap: var(--space-lg);
    /* allinea il testo alla gabbia .shell anche se la sezione è full-bleed */
    padding-inline-start: max(
      var(--gutter),
      calc((100% - var(--page-max)) / 2 + var(--gutter))
    );
    padding-inline-end: var(--gutter);
    /* gate 54 — il fondo pesa più del cielo: l'hero si appoggia
       alla sezione successiva invece di galleggiare */
    padding-block: clamp(var(--space-xl), 5.5vw, var(--space-2xl))
      clamp(var(--space-2xl), 8vw, var(--space-4xl));
  }

  .hero__display {
    max-width: 18ch;
  }

  /* Ogni riga è un blocco a sé: così l'andare a capo cade fra le due frasi
     e non in mezzo, e la fascia nera parte sempre a inizio riga. */
  .hero__line {
    display: block;
  }

  .hero__lede {
    max-width: 40ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-xs);
  }

  .hero__figure {
    border-inline-start: var(--rule-slab) solid var(--color-ink);
    min-height: clamp(22rem, 52vh, 38rem);
  }

  @media (width < 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__text {
      padding-inline: var(--gutter);
      padding-block-end: var(--space-xl);
    }

    .hero__figure {
      /* il divisore verticale diventa orizzontale */
      border-inline-start: 0;
      border-block-start: var(--rule-slab) solid var(--color-ink);
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (width < 40rem) {
    .hero__actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
