---
import { Image } from "astro:assets";
import lounge from "../assets/img/04-lounge.png";
import drawing from "../assets/img/04-lounge-drawing.png";
---

<section class="hero" id="top" data-hero-comparison aria-labelledby="hero-title">
  <!-- Il testo e il disegno hanno la stessa maschera, ma dimensioni fisse:
       il separatore li cancella senza spostarli o cambiare gli a capo. -->
  <div class="hero__copy" data-hero-copy>
    <div class="hero__text" data-hero-text>
      <p class="label hero__eyebrow">Progettazione &middot; Edilizia &middot; Interior design</p>

      <h1 class="display hero__display" id="hero-title">
        <span class="hero__line">Ristrutturiamo</span>
        <span class="hero__line"><span class="slab">case e attivit&agrave;</span></span>
      </h1>

      <p class="lede hero__lede">
        Siamo un&rsquo;impresa edile con uno studio di progettazione interno.
        Ci occupiamo del progetto e dei lavori, dal rilievo alla posa delle finiture.
      </p>

      <div class="hero__actions">
        <a class="btn" href="/#preventivo">
          Richiedi un preventivo
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn--ghost" href="/#metodo">Come lavoriamo</a>
      </div>
    </div>
  </div>

  <div class="hero__scene" data-hero-scene>
    <Image
      class="hero__image"
      src={lounge}
      alt="Render di una lounge con divano ocra, poltrone verde bosco e cognac, tavolini in marmo e boiserie grafite."
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      draggable="false"
    />

    <div class="hero__drawing" id="hero-drawing">
      <Image
        class="hero__image"
        src={drawing}
        alt="Disegno della stessa lounge a tratto grafite su carta avorio."
        widths={[640, 960, 1280, 1672]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        draggable="false"
      />
    </div>

    <div class="hero__controls" data-hero-controls hidden>
      <div class="hero__divider" aria-hidden="true"></div>
      <div
        class="hero__rail"
        data-hero-slider
        role="slider"
        tabindex="0"
        aria-label="Confronto tra disegno e render"
        aria-describedby="hero-slider-help"
        aria-controls="hero-drawing"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="64"
        aria-valuetext="64% disegno, 36% render"
      >
        <span class="hero__handle" aria-hidden="true">
          <svg viewBox="0 0 32 24" width="32" height="24" fill="none">
            <path d="m10 7-5 5 5 5M22 7l5 5-5 5M16 5v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />
          </svg>
        </span>
      </div>
      <p class="hero__hint label" aria-hidden="true">Trascina per confrontare</p>
      <p class="visually-hidden" id="hero-slider-help">
        Trascina il separatore oppure usa le frecce sinistra e destra.
        Home mostra tutto il render, Fine tutto il disegno.
      </p>
    </div>
  </div>
</section>

<script>
  import "../scripts/hero-comparison";
</script>

<style>
  .hero {
    --hero-reveal: 64%;
    --hero-copy-width: min(40rem, 46vw);
    --hero-inset: max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
    --hero-grip-size: 3.5rem;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-block-end: var(--rule-slab) solid var(--color-ink);
    background: var(--color-paper);
  }

  .hero__scene,
  .hero__copy {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .hero__scene {
    position: relative;
    min-height: clamp(34rem, calc(100svh - 5rem), 56rem);
  }

  .hero__image,
  .hero__drawing,
  .hero__controls {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    object-fit: cover;
    object-position: center;
    user-select: none;
    pointer-events: none;
  }

  .hero__drawing,
  .hero__copy {
    clip-path: inset(0 calc(100% - var(--hero-reveal)) 0 0);
  }

  .hero__copy {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    align-content: center;
    padding: var(--space-3xl) var(--hero-inset);
    pointer-events: none;
  }

  .hero__copy::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    z-index: -1;
    width: calc(var(--hero-inset) + var(--hero-copy-width) + var(--space-3xl));
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-paper) 90%, transparent),
      color-mix(in oklab, var(--color-paper) 82%, transparent) calc(100% - var(--space-3xl)),
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      var(--color-ink) calc(100% - 7rem),
      transparent calc(100% - 4rem)
    );
  }

  .hero__text {
    container-type: inline-size;
    width: var(--hero-copy-width);
    display: grid;
    gap: var(--space-lg);
    pointer-events: auto;
  }

  .hero__eyebrow {
    color: var(--color-ink-2);
  }

  .hero__display {
    font-size: min(var(--text-display), 10.5cqw);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .hero__line {
    display: block;
  }

  .hero__lede {
    max-width: 37ch;
    font-size: clamp(var(--text-md), 1.3vw + 0.5rem, var(--text-lg));
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-xs);
  }

  .hero__actions .btn--ghost {
    --btn-bg: var(--color-paper);
  }

  .hero__controls {
    z-index: var(--z-raised);
    pointer-events: none;
  }

  .hero__divider {
    position: absolute;
    inset-block: 0;
    left: var(--hero-reveal);
    width: var(--rule-slab);
    transform: translateX(-50%);
    background: var(--color-accent);
  }

  .hero__rail {
    position: absolute;
    inset-block: 0;
    /* La linea raggiunge 0 e 100%; la presa rimane dentro l'immagine. */
    left: clamp(calc(var(--hero-grip-size) / 2), var(--hero-reveal), calc(100% - var(--hero-grip-size) / 2));
    width: var(--hero-grip-size);
    display: grid;
    place-items: center;
    transform: translateX(-50%);
    pointer-events: auto;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
  }

  .hero__handle {
    display: grid;
    place-items: center;
    width: var(--hero-grip-size);
    height: var(--hero-grip-size);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: var(--rule-hair) solid var(--color-ink);
    transition: background-color var(--dur-micro) var(--ease-out);
  }

  .hero__rail:hover .hero__handle,
  .hero[data-dragging] .hero__handle {
    background: var(--color-accent-2);
  }

  .hero__rail:focus-visible {
    outline: none;
  }

  .hero__rail:focus-visible .hero__handle {
    outline: var(--rule-slab) solid var(--color-ink);
    outline-offset: 4px;
  }

  .hero__hint {
    position: absolute;
    inset-block-end: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .hero[data-interacted] .hero__hint {
    visibility: hidden;
  }

  .hero[data-dragging] {
    user-select: none;
  }

  @media (width < 60rem) {
    .hero {
      --hero-reveal: 50%;
      --hero-copy-width: 100%;
      --hero-inset: var(--gutter);
      --hero-grip-size: 3rem;
    }

    .hero__copy {
      grid-area: 1 / 1;
      clip-path: none;
      padding-block: var(--space-xl);
    }

    .hero__copy::before {
      display: none;
    }

    .hero__text {
      max-width: 42rem;
    }

    .hero__display {
      font-size: min(var(--text-display), 11.5cqw);
    }

    .hero__scene {
      grid-area: 2 / 1;
      min-height: 0;
      aspect-ratio: 1672 / 941;
      border-block-start: var(--rule-slab) solid var(--color-ink);
    }

    .hero__hint {
      inset-block-start: var(--space-sm);
      inset-block-end: auto;
    }
  }

  @media (width < 40rem) {
    .hero__actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__handle {
      transition: none;
    }
  }
</style>
