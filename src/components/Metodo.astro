---
/**
 * F4 · Step sequence — knobs: numerazione 01/02/03 · layout vertical stack ·
 * connettore nessuno. Il numerale sta in linea col titolo, non in una
 * colonna a sinistra: la testa di sezione resta una colonna sola (gate 66).
 * Il contenuto è realmente ordinale, quindi la numerazione è ammessa.
 */

const stages = [
  {
    n: "01",
    title: "Progettazione",
    prose:
      "Rileviamo le misure dell&rsquo;immobile e studiamo la distribuzione degli ambienti. Prepariamo planimetrie e render per discutere con te il progetto, poi sviluppiamo i disegni tecnici per i lavori.",
    items: [
      "Rilievo e studio delle planimetrie",
      "Proposte di arredo e materiali",
      "Render fotorealistici",
      "Progettazione tecnica ed esecutiva",
    ],
  },
  {
    n: "02",
    title: "Lavori edili",
    prose:
      "Organizziamo le lavorazioni e coordiniamo le squadre in cantiere. Seguiamo le opere murarie e gli impianti, verificando l&rsquo;avanzamento rispetto al progetto e al programma concordato.",
    items: [
      "Demolizioni e opere murarie",
      "Impianti elettrici, idraulici, climatizzazione",
      "Coordinamento squadre e fornitori",
      "Direzione lavori e sicurezza",
    ],
  },
  {
    n: "03",
    title: "Materiali e finiture",
    prose:
      "Ti aiutiamo a scegliere pavimenti, rivestimenti e arredi in base al progetto e al budget. Per gli ambienti di hotel e B&B valutiamo la resistenza all&rsquo;usura e le esigenze di pulizia e manutenzione.",
    items: [
      "Rivestimenti e pavimentazioni",
      "Ceramiche e arredo bagno",
      "Materiali tecnici a uso intensivo",
      "Arredo su misura e complementi",
    ],
  },
];
---

<section class="metodo on-ink" id="metodo">
  <div class="shell">
    <div class="head metodo__head">
      <h2 class="head__title">Come lavoriamo</h2>
      <p class="head__note">
        Curiamo il progetto, organizziamo il cantiere e ti affianchiamo
        nella scelta dei materiali.
      </p>
    </div>

    <ol class="metodo__stages">
      {
        stages.map((stage) => (
          <li class="stage">
            <h3 class="stage__heading">
              <span class="stage__n" aria-hidden="true">
                {stage.n}
              </span>
              <span class="stage__title">{stage.title}</span>
            </h3>

            <div class="stage__body">
              <p class="stage__prose" set:html={stage.prose} />

              <div class="stage__aside">
                <ul class="stage__list">
                  {stage.items.map((item) => (
                    <li class="stage__item">{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .metodo {
    padding-block: clamp(var(--space-2xl), 9vw, var(--space-4xl));
  }

  .metodo__head .head__title {
    border-block-end: var(--rule-heavy) solid var(--color-accent);
    padding-block-end: var(--space-md);
  }

  .metodo__stages {
    display: grid;
  }

  .stage {
    padding-block: clamp(var(--space-xl), 4vw, var(--space-2xl));
    border-block-start: var(--rule-slab) solid var(--color-on-ink-rule);
  }

  .stage:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .stage__heading {
    display: flex;
    align-items: baseline;
    gap: clamp(var(--space-md), 2vw, var(--space-xl));
    margin-block-end: var(--space-lg);
  }

  .stage__n {
    flex: none;
    font-family: var(--font-outlier);
    font-weight: 500;
    font-size: clamp(var(--text-lg), 2vw + 0.5rem, var(--text-2xl));
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .stage__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(var(--text-xl), 3.6vw + 0.5rem, var(--text-3xl));
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .stage__body {
    display: grid;
    /* colonne disuguali, la prosa più larga dell'elenco */
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(var(--space-lg), 4vw, var(--space-3xl));
    align-items: start;
  }

  .stage__prose {
    /* stessa scala della prosa dei pannelli Casa/Attività */
    font-size: clamp(var(--text-base), 0.7vw + 0.85rem, var(--text-md));
    line-height: 1.45;
    max-width: 46ch;
    color: var(--color-on-ink-2);
  }

  .stage__aside {
    display: grid;
    gap: var(--space-lg);
  }

  .stage__list {
    display: grid;
  }

  .stage__item {
    padding-block: var(--space-sm);
    border-block-end: var(--rule-hair) solid var(--color-on-ink-rule);
    font-size: var(--text-base);
    color: var(--color-on-ink);
  }

  @media (width < 60rem) {
    .stage__body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (width < 40rem) {
    .stage__heading {
      /* il numerale scende sopra al titolo, resta nella stessa colonna */
      flex-direction: column;
      align-items: start;
      gap: var(--space-2xs);
    }
  }
</style>
