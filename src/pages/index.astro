---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Portfolio from "../components/Portfolio.astro";
import Duality from "../components/Duality.astro";
import Servizi from "../components/Servizi.astro";
import Metodo from "../components/Metodo.astro";
import Garanzie from "../components/Garanzie.astro";
import Preventivo from "../components/Preventivo.astro";
import Footer from "../components/Footer.astro";
import { contatti } from "../data/contatti";

const title = "Vision Ark | Progettazione e ristrutturazioni di case e attività";
const description =
  "Progettiamo e ristrutturiamo abitazioni, hotel e locali commerciali. Guarda i render e le foto dei nostri lavori e richiedi un preventivo.";

const schema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: "Vision Ark",
  alternateName: "Vision Ark — interior & more",
  description,
  areaServed: "IT",
  knowsAbout: [
    "Ristrutturazioni",
    "Interior design",
    "Progettazione architettonica",
    "Ristrutturazione hotel e B&B",
  ],
  url: "https://visionark.it/",
  email: contatti.email,
  telephone: contatti.telefonoHref,
  vatID: contatti.partitaIva,
  address: {
    "@type": "PostalAddress",
    streetAddress: contatti.sede.via,
    postalCode: contatti.sede.cap,
    addressLocality: contatti.sede.comune,
    addressRegion: contatti.sede.provincia,
    addressCountry: "IT",
  },
  // TODO: logo, image — serve il marchio esportato in file.
};
---

<Base title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema)}
  />

  <Nav />

  <main id="contenuto">
    <Hero />
    <Manifesto />
    <Portfolio />
    <Duality />
    <Servizi />
    <Metodo />
    <Garanzie />
    <Preventivo />
  </main>

  <Footer />
</Base>
